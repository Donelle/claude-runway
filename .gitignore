.vscode/
.venv/
.DS_Store

# pyproject.toml packaging build artifacts -- generated locally
# by `pip install -e .` / `python -m build` / `uv build`, never committed.
*.egg-info/
build/
dist/
.mypy_cache/

# Local dogfood install of this toolkit on itself -- contains machine-specific
# absolute paths, so it is not portable to another clone.
.mcp.json
.plans/
.ai-docs/
.claude/
CLAUDE.md
.ai-plans/

# Written into the repo root by sync_repo/index_repo to track what's already
# indexed -- per-checkout state that shouldn't be committed.
.qdrant_index_manifest.json

# Local scratch state and uv-generated lock file -- per-machine, never committed.
:m*
*.lock

# harness/: recorded Copilot review snapshots, regenerated by harness/collect_copilot_history.py
harness/history/
